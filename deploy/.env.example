# FRC eFact — variables de producción (VM Hetzner)
# Copiar a deploy/.env y completar. NUNCA commitear deploy/.env.

# --- Dominios (registros A apuntando a la IP de la VM) ---
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
ACME_EMAIL=frcsistemasinformaticos@gmail.com

# --- PostgreSQL local (contenedor) ---
# Solo alfanumérico: DatabaseConfig parsea DATABASE_URL como URI
POSTGRES_PASSWORD=

# --- Secretos de la aplicación ---
# Mínimo 512 bits (64+ chars) para HS512. Generar: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
# ⚠️ CRÍTICO: exactamente la misma clave que usaba Render (32 chars).
# Si difiere, los CSC y passwords de certificados guardados en la DB quedan indescifrables.
ENCRYPTION_KEY=
# App password de Gmail (frcsistemasinformaticos@gmail.com)
MAIL_PASSWORD=

# --- GitHub Packages (build de jsifenlib) ---
# PAT con scope read:packages (el anterior fue filtrado y debe estar revocado)
GITHUB_USERNAME=GabFrank
GITHUB_TOKEN=

# --- SIFEN (replicar valores del dashboard de Render) ---
SIFEN_ENABLED=true
SIFEN_AMBIENTE=PROD
SIFEN_SCHEDULER_ENABLED=true

# --- Solo para la migración inicial (deploy/migrate-db-from-render.sh) ---
# External Database URL de Render (dashboard → frc-efact-db → Connections)
RENDER_DATABASE_URL=
