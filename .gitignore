# FRC eFact Webapp - Root .gitignore

# ============================================
# IDE files
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.settings/
.project
.classpath
*.iml
*.ipr
*.iws
# Cursor MCP configuration (ignore real config, allow example)
.cursor/mcp.json
!.cursor/mcp.json.example
.env
# ============================================
# OS generated files
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ============================================
# Logs
# ============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================
# Environment variables
# ============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# Temporary files
# ============================================
tmp/
temp/
*.tmp

# ============================================
# Documentation build
# ============================================
docs/_build/

# ============================================
# Backend (Spring Boot / Maven)
# ============================================
frc-efact-backend/target/
frc-efact-backend/*.jar
frc-efact-backend/*.war
frc-efact-backend/*.class
frc-efact-backend/.mvn/
frc-efact-backend/mvnw
frc-efact-backend/mvnw.cmd

# ============================================
# Frontend (Angular / Node)
# ============================================
frc-efact-frontend/node_modules/
frc-efact-frontend/dist/
frc-efact-frontend/.angular/
frc-efact-frontend/coverage/
frc-efact-frontend/*.js.map

# ============================================
# General build artifacts
# ============================================
**/target/
**/dist/
**/build/
**/node_modules/
**/.angular/

# ── Secretos y material criptográfico (agregado 2026-08-05, ver docs/TAREAS_PENDIENTES.md §9)
# Los .pfx NO los necesita el build: el Dockerfile solo hace `mkdir -p /app/certificates`
# y en producción los certificados vienen del volumen Docker `certificates`, cargados a mano
# (ver docs/deployment/hetzner/RUNBOOK_VM.md paso 5). Estaban versionados por error.
*.pfx
*.p12
*.jks
*.keystore
client_secret*.json
*service-account*.json
